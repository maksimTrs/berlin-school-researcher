{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash",
      "WebFetch",
      "WebSearch",
      "Bash(npm run resolve *)",
      "Bash(npm run lookup *)",
      "Bash(npm run plz *)",
      "Bash(npm run context *)",
      "Bash(npm run canary)",
      "Bash(npm run preflight)",
      "Bash(npm test)",
      "Bash(npm run test:smoke)",
      "Bash(npm run typecheck)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/scripts/install_pkgs.sh; bash \"$CLAUDE_PROJECT_DIR\"/scripts/stale_check.sh"
          }
        ]
      },
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/scripts/canary-hook.mjs",
            "asyncRewake": true,
            "timeout": 1800
          }
        ]
      }
    ]
  }
}
